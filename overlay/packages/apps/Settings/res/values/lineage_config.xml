<resources>
    <!--
        Refresh-rate pickers are intentionally disabled. The panel exposes a
        144Hz mode, but the active pen only scans at <=120Hz (the NVT
        controller cannot fit pen scan in the 144Hz frame), so 144 must not be
        user selectable or it silently breaks the stylus. Both LineageOS list
        pickers and the AOSP smooth-display switch resolve the panel's max
        (144) directly from the hardware mode list and cannot be capped by an
        overlay, so all three are turned off here. The panel runs dynamic up to
        config_defaultPeakRefreshRate (120, set in the framework overlay) and
        SurfaceFlinger idles it lower for power. 120 is the highest pen-safe
        rate and matches what stock actually runs the pen at.
    -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <bool name="config_show_min_refresh_rate_switch">true</bool>
    <bool name="config_show_smooth_display">true</bool>

    <!--
        Show clipboard history management in Settings → Privacy → Clipboard.
        Allows users to clear history, review what was copied, and toggle
        clipboard access notifications (the floating preview pill).
    -->
    <bool name="config_show_clipboard_access_notifications">true</bool>

    <!--
        Show the edge panel / sidebar gesture toggle in
        Settings → Buttons → Swipe from edge. Activates LineageOS's
        built-in swipe-in app-launcher sidebar panel.
    -->
    <bool name="config_showEdgeGestureToggle">true</bool>

    <!--
        Show the screenshot intelligence toggle in Settings → Display.
        Allows users to enable/disable on-device text selection and
        QR decode actions in the screenshot preview tray.
    -->
    <bool name="config_show_screenshot_intelligence">true</bool>

</resources>
