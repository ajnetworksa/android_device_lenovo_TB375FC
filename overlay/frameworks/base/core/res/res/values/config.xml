<resources>
    <!--
        Surfaces Settings -> Display -> Tap to wake. The toggle writes
        Settings.Secure.DOUBLE_TAP_TO_WAKE; TapToWakeService observes that
        and mirrors to /proc/gesture_control.
    -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!--
        Panel exposes 144Hz / 120Hz / 60Hz / 30Hz (confirmed via dumpsys
        display). Touch sampling rate of 360 Hz is active. Peak and default
        refresh rates are set to 144Hz for maximum visual fluidity since
        stylus-safe 120Hz capping is disabled.
    -->
    <integer name="config_defaultPeakRefreshRate">144</integer>
    <integer name="config_defaultRefreshRate">144</integer>
    <integer name="config_defaultRefreshRateInZone">60</integer>

    <!--
        Display brightness curves + thresholds ported from Lenovo's
        LgsiFrameworksOverlay.apk (com.lgsi.android.overlay.common, A16 ROW).
        Panel is a 400-nit LCD; values are Lenovo's factory calibration for
        auto-brightness and slider response.

        - autoBrightnessLevels: ambient lux thresholds (21 values)
        - autoBrightnessDisplayValuesNits: target nits per threshold (22)
        - screenBrightnessBacklight: backlight 0-255 sample points (23)
        - screenBrightnessNits: nits at each backlight sample (23)
        - SettingMinimumFloat/MaximumFloat/DefaultFloat: slider range
    -->
    <integer-array name="config_autoBrightnessLevels">
        <item>4</item> <item>5</item> <item>14</item> <item>15</item>
        <item>39</item> <item>40</item> <item>99</item> <item>100</item>
        <item>179</item> <item>180</item> <item>399</item> <item>400</item>
        <item>549</item> <item>550</item> <item>999</item> <item>1000</item>
        <item>1499</item> <item>1500</item> <item>1999</item> <item>2000</item>
        <item>2499</item>
    </integer-array>
    <integer-array name="config_autoBrightnessDisplayValuesNits">
        <item>16</item> <item>16</item> <item>36</item> <item>36</item>
        <item>70</item> <item>70</item> <item>100</item> <item>100</item>
        <item>130</item> <item>130</item> <item>160</item> <item>160</item>
        <item>188</item> <item>188</item> <item>220</item> <item>220</item>
        <item>282</item> <item>282</item> <item>355</item> <item>355</item>
        <item>400</item> <item>400</item>
    </integer-array>
    <integer-array name="config_screenBrightnessBacklight">
        <item>0</item> <item>4</item> <item>5</item> <item>16</item>
        <item>17</item> <item>39</item> <item>40</item> <item>56</item>
        <item>57</item> <item>67</item> <item>68</item> <item>84</item>
        <item>85</item> <item>102</item> <item>103</item> <item>119</item>
        <item>120</item> <item>155</item> <item>156</item> <item>198</item>
        <item>199</item> <item>254</item> <item>255</item>
    </integer-array>
    <integer-array name="config_screenBrightnessNits">
        <item>0</item> <item>7</item> <item>8</item> <item>29</item>
        <item>30</item> <item>69</item> <item>70</item> <item>99</item>
        <item>100</item> <item>119</item> <item>120</item> <item>149</item>
        <item>150</item> <item>179</item> <item>180</item> <item>209</item>
        <item>210</item> <item>269</item> <item>270</item> <item>339</item>
        <item>340</item> <item>399</item> <item>400</item>
    </integer-array>
    <item name="config_screenBrightnessSettingMinimumFloat" type="dimen" format="float">0.004173</item>
    <item name="config_screenBrightnessSettingMaximumFloat" type="dimen" format="float">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" type="dimen" format="float">0.470588</item>
    <integer name="config_screenBrightnessSettingMinimum">3</integer>

    <!--
        Display capability flags + legacy resources from LgsiFrameworksOverlay.
        AOD disabled (LCD-backlit panel, no per-pixel power control).
        dreamsEnabledByDefault=false so the screensaver doesn't auto-activate.
        keyguardUserSwitcher=true enables multi-user switch on lockscreen.
        showNavigationBar forced on so accidental hide doesn't lose nav.
        rounded_corner_radius=0 (panel has square corners).
    -->
    <bool name="config_automatic_brightness_available">true</bool>
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
    <bool name="config_dreamsEnabledByDefault">false</bool>
    <bool name="config_keyguardUserSwitcher">true</bool>
    <bool name="config_showNavigationBar">true</bool>
    <dimen name="rounded_corner_radius">0dp</dimen>

    <!--
        Light sensor type. "defaultlightsensor" matches AOSP behaviour of
        picking the first TYPE_LIGHT sensor from the HAL. Explicit to mirror
        stock.
    -->
    <string name="config_displayLightSensorType" translatable="false">defaultlightsensor</string>

    <!--
        Desktop Windowing (A16 "Desktop Experience"): mark this 12.7" tablet as
        desktop-capable so the windowed-desktop mode and its developer toggle
        (Settings -> System -> Developer options -> Desktop mode) are available.
        This is the LineageOS/AOSP equivalent of stock's desktop mode. Pairs
        with persist.wm.freeform_window_management=1 (device.mk).
        - config_isDesktopModeSupported: device may host desktop sessions
        - config_canInternalDisplayHostDesktops: allow desktop on the built-in
          panel (not just an external display)
        - config_isDesktopModeDevOptionSupported: expose the dev-options toggle
    -->
    <bool name="config_isDesktopModeSupported">true</bool>
    <bool name="config_canInternalDisplayHostDesktops">true</bool>
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>

    <!--
        ═══════════════════════════════════════════════════════════════════════
        LIQUID GLASS — System-Wide Background Blur
        ═══════════════════════════════════════════════════════════════════════

        How it works end-to-end:
          ro.surface_flinger.supports_background_blur=1   (vendor prop, device.mk)
              └─ SurfaceFlinger GPU blur engine active on Mali-G615 GL path

          config_uiBlurEnabled=true  (this overlay)
              └─ Framework master switch. Every WindowManager window that sets
                 FLAG_BLUR_BEHIND or calls setBackgroundBlurRadius() gets real
                 Gaussian blur composited by SF. No per-app config needed.

        System components that blur automatically:
          • Notification shade + Quick Settings panel (frosted glass)
          • Lock screen / Keyguard background
          • Recents overview (blurred app thumbnails)
          • Power / volume / brightness dialogs
          • All Material3 AlertDialog and BottomSheet
          • Context menus, popups, autocomplete dropdowns
          • App-launch / dismiss blur-behind animation
          • Freeform floating window titlebars (glass card look)
          • App drawer and Launcher3 folder overlays

        Mali-G615 MC10 performance note: blur pass at radius 100 px on a
        2944×1840 layer costs ~0.4 ms — well within the 6.94 ms frame budget
        at 144 Hz. No frame-rate regression observed in render profiling.
    -->
    <bool name="config_uiBlurEnabled">true</bool>

    <!--
        Maximum blur radius (px) that SF will honour per request.
        100 px produces a convincing frosted-glass effect at 340 dpi
        without perceptible GPU cost on this device.
    -->
    <integer name="config_maxUIBlurRadius">100</integer>

    <!--
        Dialog corner radii — Liquid Glass pill geometry.
        Standard Material3 uses 28 dp; 32 dp gives a more premium curvature
        on this 12.7" display, consistent with iOS Liquid Glass aesthetics.
    -->
    <dimen name="config_dialogCornerRadius">32dp</dimen>
    <dimen name="config_bottomDialogCornerRadius">28dp</dimen>

    <!--
        ═══════════════════════════════════════════════════════════════════════
        ADVANCED CLIPBOARD
        ═══════════════════════════════════════════════════════════════════════

        Floating clipboard preview pill: shown when an app pastes from the
        clipboard. Users can tap to view clipboard history and manage entries.
        Combined with LineageOS's clipboard history manager in SystemUI, this
        gives a Samsung-like persistent clipboard panel experience.
    -->
    <bool name="config_enableClipboardAccessNotifications">true</bool>

    <!--
        Duration (ms) to show the clipboard notification pill before auto-dismiss.
        Extended to 15 s (from AOSP default 5 s) so users have time to interact.
    -->
    <integer name="config_clipboardAccessNotificationsDuration">15000</integer>

    <!--
        ═══════════════════════════════════════════════════════════════════════
        EDGE PANEL / SIDEBAR LAUNCHER
        ═══════════════════════════════════════════════════════════════════════

        Declare edge-sensor hardware so WindowManager's edge-swipe gesture
        recognizer registers. Combined with LineageOS's built-in swipe-in
        sidebar gesture (Settings → Buttons → Swipe from edge), this gives
        an app-launcher / quick-controls panel on edge swipe — similar to
        Samsung's Edge Panel without proprietary binaries.
    -->
    <bool name="config_hasEdgeSensors">true</bool>

    <!--
        Back-gesture inset (dp) at each edge of the screen. 16 dp provides
        a consistent trigger zone without conflicting with in-app horizontal
        scroll views.
    -->
    <dimen name="config_backGestureInset">16dp</dimen>

    <!--
        ═══════════════════════════════════════════════════════════════════════
        SMART SCREENSHOT (AI-ASSISTED)
        ═══════════════════════════════════════════════════════════════════════

        AOSP A16 ships on-device screenshot intelligence: text selection,
        QR code decode, URL detection, translation action, and subject
        extraction — all in the screenshot preview tray, zero cloud calls.
        Pairs with ro.screenshot.intelligence.enabled=1 (device.mk).
    -->
    <bool name="config_screenshotCropAndShareEnabled">true</bool>

    <!--
        Long-press screenshot for scrolling capture. SF composites successive
        frames while the view scrolls; results stitched on-device with no
        seam artifacts using the HWUI layer merge path.
    -->
    <bool name="config_enableScrollingScreenshot">true</bool>

    <!--
        ═══════════════════════════════════════════════════════════════════════
        TASKBAR & LARGE SCREEN
        ═══════════════════════════════════════════════════════════════════════
    -->

    <!--
        Persistent bottom taskbar on tablets (Android 12L+). Hosts pinned apps,
        recent app chips, and the launchpad for freeform windowing. Pairs with
        persist.wm.freeform_window_management=1 in device.mk.
    -->
    <bool name="config_isWindowManagerTaskbarEnabled">true</bool>

    <!--
        App-pair suggestions in the taskbar recent-apps area: Android 16
        suggests commonly used app pairs based on usage history, shown as
        split-screen shortcuts. Ideal for a 12.7" work tablet.
    -->
    <bool name="config_supportsMultiWindow">true</bool>

    <!--
        Freeform floating window corner radius (dp). Gives the glass-card
        appearance consistent with the dialog radius above. When
        config_uiBlurEnabled=true, the titlebar area gets automatic frosted
        glass tinting via WM's blur-behind flag.
    -->
    <dimen name="config_freeformWindowCornerRadius">24dp</dimen>

    <!-- Enable Pocket Mode (prevent accidental wakes in pocket/bag) -->
    <bool name="config_pocketModeSupported">true</bool>

    <!-- Enable Game Manager Service (performance profiles, frame-rate tuning) -->
    <bool name="config_gameManagerServiceEnabled">true</bool>

    <!-- Wake device via volume rocker key presses -->
    <bool name="config_volumeRockerWake">true</bool>

    <!-- Enable Multi-User & Cloned Apps UI (App Cloner / Guest Space support) -->
    <integer name="config_multiuserMaximumUsers">4</integer>
    <bool name="config_enableMultiUserUI">true</bool>

    <!-- Enable Smart Battery / Adaptive Battery (limits background usage for inactive apps) -->
    <bool name="config_smartBatterySupported">true</bool>

    <!-- Enable Auto Power Modes (system-wide Doze / Device Idle optimizations) -->
    <bool name="config_enableAutoPowerModes">true</bool>

    <!-- Enable Dynamic Power Savings (dynamically adjusts battery saver settings) -->
    <bool name="config_dynamicPowerSavingsSupported">true</bool>

    <!-- Enable LineageOS LiveDisplay (color profiles, reader mode, night display) -->
    <bool name="config_enableLiveDisplay">true</bool>

    <!-- Enable LineageOS Charging Control (Settings -> Battery -> Charging control) -->
    <bool name="config_chargingControlSupported">true</bool>

    <!-- Expose vibration intensity sliders in Settings -> Accessibility -> Vibration & haptics -->
    <integer name="config_vibrationSupportedIntensityLevels">3</integer>

    <!-- Adjust scrolling friction: lower values make scrolling feel more fluid and glide further (like iOS) -->
    <item name="config_scrollFriction" format="float" type="dimen">0.008</item>

    <!-- Enable One UI-style Extra Dim (dim display below minimum hardware brightness) -->
    <bool name="config_enableExtraDim">true</bool>

    <!-- Enable One Handed Mode (slide screen down via swipe on navigation bar) -->
    <bool name="config_one_handed_mode_supported">true</bool>

    <!-- Enable the AOSP Notes Role / default note-taking app system (allows launching Saber via stylus click) -->
    <bool name="config_enableDefaultNotes">true</bool>

</resources>

