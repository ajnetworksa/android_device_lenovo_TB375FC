<!--
    Framework manifest fragment declaring the MTK SurfaceFlinger extension HAL.

    Source: extracted from stock TB375FC ZUI A16
    (/system/etc/vintf/manifest/mtksf_ext-mtk-default.xml).

    Required because vendor's libpowerhal calls
    AServiceManager_getService("vendor.mediatek.framework.mtksf_ext.IMtkSF_ext/default")
    at init. Without this declaration in the framework manifest, the service lookup returns
    NULL and libpowerhal::init() crashes at +1048 with SIGSEGV writing to a NULL pointer.

    NOTE: ro.vendor.magt.mtk_magt_support is set to 0 in device.mk (magt binary disabled;
    it links android.hardware.thermal@2.0, a deprecated HIDL interface AOSP A16 no longer
    ships). IMtkSF_ext/default is registered by the SurfaceFlinger extension stack in
    system_ext independently of magt.

    IMPORTANT: this file MUST be installed to the system partition via PRODUCT_COPY_FILES
    in device.mk (see the entry for TARGET_COPY_OUT_SYSTEM). The manifest/ directory is
    NOT auto-scanned by the build system.
-->
<manifest version="9.0" type="framework">
    <hal format="aidl">
        <name>vendor.mediatek.framework.mtksf_ext</name>
        <version>9</version>
        <fqname>IMtkSF_ext/default</fqname>
    </hal>
</manifest>
